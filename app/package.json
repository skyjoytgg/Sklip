{
  "name": "sklip",
  "productName": "Sklip",
  "version": "0.1.3",
  "description": "Montage automatique des moments forts de tes streams Twitch Valorant",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "build:ui": "esbuild src/renderer/app.jsx --bundle --outfile=dist/renderer.js --jsx=automatic --loader:.js=jsx --define:process.env.NODE_ENV=\\\"production\\\" --minify",
    "start": "npm run build:ui && electron .",
    "test": "node --test test/*.test.js",
    "dist": "npm run build:ui && electron-builder --win nsis --publish never",
    "release": "npm run build:ui && node scripts/write-config.js && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "fr.sklip.app",
    "productName": "Sklip",
    "files": [
      "src/main/**",
      "src/preload.js",
      "src/renderer/index.html",
      "src/renderer/styles.css",
      "dist/renderer.js",
      "config.json"
    ],
    "extraResources": [
      {
        "from": "../engine/dist/sklip-engine",
        "to": "engine"
      },
      {
        "from": "../vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Sklip-Setup-${version}.exe",
      "shortcutName": "Sklip"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "skyjoytgg",
        "repo": "sklip",
        "releaseType": "draft"
      }
    ]
  }
}
